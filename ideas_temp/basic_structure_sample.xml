<TEI xmlns="http://www.tei-c.org/ns/1.0">
    <teiHeader>
        <!-- Header information for the entire composite collection (Sammelband) -->
        <!-- Derived from top-level JSON fields: title, source, processing_log.is_collection,
        epub_metadata -->
    </teiHeader>
    <text>
        <front>
            <!-- Front matter for the composite collection (e.g., overall cover, overall TOC,
            overall impressum) -->
            <!-- Derived from top-level JSON content items (EpubHtml) with types like "cover",
            "intro", "toc" -->
        </front>
        <group>
            <!-- This group holds all the individual novels/volumes -->
            <!-- Each 'Section' object in your top-level JSON 'content' array maps to a <text> here -->
            <text xml:id="novel1">
                <teiHeader>
                    <!-- Header information for the FIRST individual novel -->
                    <!-- Derived from the 'Section' object's title, inferred-type, etc. -->
                </teiHeader>
                <front>
                    <!-- Front matter for the FIRST individual novel (e.g., its own cover, preface,
                    TOC) -->
                    <!-- Derived from EpubHtml items nested within this 'Section' in JSON -->
                </front>
                <body>
                    <!-- Body of the FIRST individual novel (chapters, etc.) -->
                    <!-- Derived from EpubHtml items nested within this 'Section' in JSON, typically
                    is_narrative: true -->
                </body>
                <back>
                    <!-- Back matter for the FIRST individual novel (e.g., specific feedback,
                    appendices) -->
                    <!-- Derived from EpubHtml items nested within this 'Section' in JSON, e.g.,
                    inferred-type: "feedback" -->
                </back>
            </text>
            <text xml:id="novel2">
                <teiHeader>
                    <!-- Header information for the SECOND individual novel -->
                </teiHeader>
                <front>
                    <!-- Front matter of second text -->
                </front>
                <body>
                    <!-- Body of second text -->
                </body>
                <back>
                    <!-- Back matter of second text -->
                </back>
            </text>
            <!-- ... more <text> elements for other novels ... -->
        </group>
        <back>
            <!-- Back matter for the composite collection (e.g., overall feedback, overall
            Leseempfehlung) -->
            <!-- Derived from top-level JSON content items (EpubHtml) with types like "feedback",
            "reading-sample" -->
        </back>
    </text>
</TEI>