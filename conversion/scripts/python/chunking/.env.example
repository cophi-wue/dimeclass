# Local LM Studio (optional)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=your-local-model-name
LM_STUDIO_API_KEY=lm-studio

# OpenRouter
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPEN_ROUTER_MODEL=your-openrouter-model
OPEN_ROUTER_API_KEY=replace-with-your-openrouter-key

# Ollama/OpenWebUI
OLLAMA_BASE_URL=https://your-ollama-host/api
OLLAMA_MODEL=your-ollama-model
OLLAMA_API_KEY=replace-with-your-ollama-key
